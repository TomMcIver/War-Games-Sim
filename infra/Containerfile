# Dev image: Rust toolchain + Python (venv) + maturin + PyTorch (CPU).
FROM docker.io/library/rust:1-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-dev python3-pip build-essential git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:/usr/local/cargo/bin:$PATH
RUN pip install --no-cache-dir maturin numpy pytest \
 && pip install --no-cache-dir torch --extra-index-url https://download.pytorch.org/whl/cpu
# Lint/format tooling for infra/test-all.sh (last, so the layers above stay cached).
RUN rustup component add rustfmt clippy
WORKDIR /work
